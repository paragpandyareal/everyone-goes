# Copy this file to .env and fill it in. Never commit .env.
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# Room 12 PTA Trips (US Business sandbox account). REST app with Invoicing + Transaction search.
TRIPS_CLIENT_ID=
TRIPS_CLIENT_SECRET=
TRIPS_EMAIL=
TRIPS_WEBHOOK_ID=

# Room 12 PTA Cover Fund (US Business sandbox account). REST app with Save payment methods (Vault) + Payouts.
COVERFUND_CLIENT_ID=
COVERFUND_CLIENT_SECRET=
COVERFUND_EMAIL=
COVERFUND_WEBHOOK_ID=

# Sponsor payers (US Business sandbox accounts, no REST app needed)
SPONSOR_ROSA_EMAIL=
SPONSOR_CORNER_EMAIL=

# Parent payers (US Personal sandbox accounts), comma separated
PARENT_EMAILS=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# live = real AI calls, mock = stored replies (no key needed)
AGENT_MODE=live
AGENT_RUNS_PER_HOUR=30
AGENT_RUNS_PER_DAY=250

# Long random strings (any 32+ characters)
LINK_TABLE_KEY=
APPROVAL_SIGNING_KEY=
ADMIN_TOKEN=

# 1 = public judge demo (role pages open). 0 = real school: coordinator, treasurer and lead need STAFF_PASSCODE.
DEMO_MODE=1
STAFF_PASSCODE=
# Sandbox-only logins shown on the hub, e.g. [{"role":"Rosa's Bakery (sponsor)","email":"...","password":"..."}]
DEMO_LOGINS=
# Anti-abuse limits (defaults shown)
FAMILY_COVERS_PER_TERM=3
CLASS_COVER_SHARE=0.34
PLEDGE_COVERS_PER_DAY=6
GLOBAL_COVERS_PER_DAY=30
REQUESTS_PER_LINK_PER_DAY=4

APP_BASE_URL=http://localhost:3100
# Leave empty locally to use the built in PGlite database
DATABASE_URL=
